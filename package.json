{
  "name": "super-bom",
  "version": "0.1.0",
  "private": true,
  "description": "SAPUI5 Super BOM Configurator foundation",
  "scripts": {
    "start": "npm run build:viewer && npm run build:blueprint && ui5 serve --accept-remote-connections --open index.html",
    "build": "npm run build:viewer && npm run build:blueprint && ui5 build --clean-dest",
    "build:viewer": "rspack build --config viewer.rspack.config.mjs",
    "build:blueprint": "rspack build --config blueprint.rspack.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run typecheck && npm run lint && npm run test:configuration",
    "test:configuration": "node --experimental-strip-types --test tests/configuration.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rspack/cli": "^2.0.3",
    "@rspack/core": "^2.0.3",
    "@sapui5/types": "1.152.0",
    "@types/three": "0.184.1",
    "@ui5/cli": "^4.0.64",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "ui5-tooling-transpile": "^3.13.1"
  },
  "dependencies": {
    "@retejs/lit-plugin": "2.0.8",
    "lit": "3.3.3",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-connection-plugin": "2.0.5",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-render-utils": "2.0.3",
    "rete-scopes-plugin": "^2.1.1",
    "three": "0.184.0"
  }
}
