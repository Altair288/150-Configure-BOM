<mvc:View
  controllerName="com.company.superbom.controller.Configurator"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Page title="{i18n>configuratorTitle}">
    <content>
      <VBox class="sapUiContentPadding" width="100%">
        <MessageStrip
          text="{i18n>configuratorInfo}"
          type="Information"
          showIcon="true" />
        <f:SimpleForm
          editable="true"
          layout="ResponsiveGridLayout"
          title="{i18n>configurationInputs}"
          class="sapUiMediumMarginTop">
          <f:content>
            <Label text="{i18n>engine}" />
            <Select selectedKey="{config>/engine}" change=".onConfigurationChange">
              <items>
                <core:Item key="2.0T" text="2.0T" />
                <core:Item key="1.5T" text="1.5T" />
              </items>
            </Select>
            <Label text="{i18n>gearbox}" />
            <Select selectedKey="{config>/gearbox}" enabled="false">
              <items>
                <core:Item key="8AT" text="8AT" />
                <core:Item key="7DCT" text="7DCT" />
              </items>
            </Select>
            <Label text="{i18n>seatMaterial}" />
            <Select selectedKey="{config>/seatMaterial}" change=".onConfigurationChange">
              <items>
                <core:Item key="Leather" text="Leather" />
                <core:Item key="Fabric" text="Fabric" />
              </items>
            </Select>
          </f:content>
        </f:SimpleForm>
        <Panel headerText="{i18n>enabledOptions}" class="sapUiMediumMarginTop">
          <content>
            <List items="{config>/options}">
              <StandardListItem title="{config>text}">
                <customData>
                  <core:CustomData key="optionKey" value="{config>key}" />
                </customData>
              </StandardListItem>
            </List>
          </content>
        </Panel>
        <Panel headerText="{i18n>finalBom}" class="sapUiMediumMarginTop">
          <content>
            <List items="{config>/result}">
              <StandardListItem title="{config>}" icon="sap-icon://product" />
            </List>
          </content>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>