<mvc:View
  controllerName="com.company.superbom.controller.Configurator"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Page title="{i18n>configuratorTitle}" enableScrolling="true">
    <content>
      <VBox class="sapUiContentPadding" width="100%">
        <MessageStrip
          text="{config>/status}"
          type="Information"
          showIcon="true" />
        <f:SimpleForm
          editable="true"
          layout="ResponsiveGridLayout"
          title="{i18n>bikeConfigurationInputs}"
          class="sapUiMediumMarginTop">
          <f:content>
            <Label text="{i18n>scenario}" />
            <Select selectedKey="{config>/scenario}" change=".onConfigurationChange">
              <items>
                <core:Item key="CITY" text="{i18n>scenarioCity}" />
                <core:Item key="SPORT" text="{i18n>scenarioSport}" />
                <core:Item key="GRAVEL" text="{i18n>scenarioGravel}" />
              </items>
            </Select>
            <Label text="{i18n>wheelOption}" />
            <Select selectedKey="{config>/wheelOption}" change=".onConfigurationChange">
              <items>
                <core:Item key="ROAD_28" text="700×28C 公路胎" />
                <core:Item key="CITY_35" text="700×35C 城市胎" />
                <core:Item key="GRAVEL_45" text="700×45C Gravel 胎" />
              </items>
            </Select>
            <Label text="{i18n>handleStyle}" />
            <Select selectedKey="{config>/handleStyle}" change=".onConfigurationChange">
              <items>
                <core:Item key="FLAT" text="城市平把" />
                <core:Item key="DROP" text="运动弯把" />
                <core:Item key="COMFORT" text="舒适后掠把" />
              </items>
            </Select>
            <Label text="{i18n>saddleStyle}" />
            <Select selectedKey="{config>/saddleStyle}" change=".onConfigurationChange">
              <items>
                <core:Item key="SPORT" text="运动窄座" />
                <core:Item key="COMFORT" text="舒适宽座" />
                <core:Item key="GEL" text="凝胶减震座" />
              </items>
            </Select>
            <Label text="{i18n>fenderStyle}" />
            <Select selectedKey="{config>/fenderStyle}" change=".onConfigurationChange">
              <items>
                <core:Item key="NONE" text="不配置挡泥板" />
                <core:Item key="SHORT" text="运动短挡泥板" />
                <core:Item key="FULL" text="城市全包挡泥板" />
                <core:Item key="GRAVEL" text="Gravel 宽挡泥板" />
              </items>
            </Select>
            <Label text="{i18n>rearRack}" />
            <CheckBox
              selected="{config>/rearRack}"
              select=".onConfigurationChange"
              text="{i18n>enableOption}" />
            <Label text="{i18n>lights}" />
            <CheckBox
              selected="{config>/lights}"
              select=".onConfigurationChange"
              text="{i18n>enableOption}" />
          </f:content>
        </f:SimpleForm>
        <Toolbar class="sapUiMediumMarginTop">
          <ToolbarSpacer />
          <Button
            type="Emphasized"
            icon="sap-icon://create"
            text="{i18n>generateConfiguredBom}"
            press=".onGenerateBom" />
        </Toolbar>
      </VBox>
    </content>
  </Page>
</mvc:View>