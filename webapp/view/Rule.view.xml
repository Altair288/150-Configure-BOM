<mvc:View
  controllerName="com.company.superbom.controller.Rule"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page title="{i18n>rulesTitle}">
    <content>
      <Table items="{rules>/items}" class="sapUiContentPadding">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>ruleCatalog}" level="H3" />
            <ToolbarSpacer />
            <Button type="Transparent" icon="sap-icon://add" tooltip="{i18n>createRule}" />
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>ruleName}" /></Column>
          <Column><Text text="{i18n>condition}" /></Column>
          <Column><Text text="{i18n>effect}" /></Column>
          <Column><Text text="{i18n>lifecycle}" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{rules>name}" />
              <Text text="{rules>condition}" />
              <Text text="{rules>effect}" />
              <ObjectStatus text="{rules>status}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>