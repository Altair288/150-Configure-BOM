<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
  <Dialog id="confirmDialog" title="{i18n>confirmAction}">
    <content>
      <Text text="{i18n>confirmActionText}" class="sapUiContentPadding" />
    </content>
    <beginButton>
      <Button text="{i18n>confirm}" type="Emphasized" />
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>